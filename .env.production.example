# Public, empty example only. Copy to ignored .env.production.local on the server.
# test: each assistant enters three keys in the browser; managed: server-owned keys.
GRADING_MODE=test
# Set the exact public HTTPS origin when deploying behind a reverse proxy.
# GRADING_PUBLIC_ORIGIN=https://grading.example.cn
# Required only in managed mode. Never put actual secrets in this example.
GRADING_PREPARE_API_KEY=
GRADING_API_KEY=
GRADING_REVIEW_API_KEY=
GRADING_ACCESS_CODE=
GRADING_SESSION_SECRET=
# Optional public JSON override; omit for Kimi Pro / DeepSeek Flash / Kimi Pro.
# GRADING_STAGE_PROFILES=
